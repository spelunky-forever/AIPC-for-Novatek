#!/usr/bin/env python3

import sys
import os
import subprocess
import argparse

# Resolve the script directory
SCRIPT_DIR = os.path.dirname(os.path.abspath(__file__))

# Add the project root to Python path
PROJECT_ROOT = os.path.dirname(SCRIPT_DIR)
if PROJECT_ROOT not in sys.path:
    sys.path.insert(0, PROJECT_ROOT)

# Import the main inference script
from infer_resnet34 import main

# Define the entry point
if __name__ == "__main__":
    # Parse command line arguments
    parser = argparse.ArgumentParser(description="QNN Inference Launcher")
    parser.add_argument("--model", type=str, required=True, help="Model name")
    parser.add_argument("--input_image", type=str, default="sample.jpg", help="Input image path")
    parser.add_argument("--output_file", type=str, default="inference_results.json", help="Output results file")
    parser.add_argument("--num_iterations", type=int, default=10, help="Number of inference iterations")
    parser.add_argument("--enable_profile", action="store_true", help="Enable profiling")
    parser.add_argument("--input", type=str, default="sample.jpg", help="Input image path")
    parser.add_argument("--output", type=str, default="inference_results.json", help="Output results file")
    parser.add_argument("--iterations", type=int, default=10, help="Number of inference iterations")
    parser.add_argument("--profile", action="store_true", help="Enable profiling")
    args = parser.parse_args()

    # Update the main function to accept arguments
    main(args)
